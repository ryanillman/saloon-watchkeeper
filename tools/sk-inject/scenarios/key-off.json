{
  "description": "Starboard is shut down and its key turned off: values go to 0, then the controller goes silent. Port keeps running.",
  "durationMs": 20000,
  "intervalMs": 500,
  "values": {
    "propulsion.port.revolutions": 30.0, "propulsion.starboard.revolutions": 30.5,
    "propulsion.port.temperature": 350.0, "propulsion.starboard.temperature": 351.0,
    "propulsion.port.oilPressure": 350000, "propulsion.starboard.oilPressure": 348000,
    "propulsion.port.alternatorVoltage": 14.1, "propulsion.starboard.alternatorVoltage": 14.0
  },
  "after": [
    { "atMs": 3000, "note": "starboard stops", "values": {
      "propulsion.starboard.revolutions": 0, "propulsion.starboard.oilPressure": 0 } },
    { "atMs": 5000, "note": "starboard key off: controller silent", "values": {
      "propulsion.starboard.revolutions": "$stop", "propulsion.starboard.oilPressure": "$stop",
      "propulsion.starboard.temperature": "$stop", "propulsion.starboard.alternatorVoltage": "$stop" } }
  ]
}
